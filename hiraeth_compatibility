# Historic Invasions x Hiraeth - updated for current Hiraeth (4.0) + Historic Invasions Fix and Addon (by PreFire)
# Translates Historic Invasions (+ Fix and Addon) invader dynasty perks to Hiraeth - Dynasty Legacies Overhaul's
# redesigned tracks, so invader dynasties get the right legacies. Each effect is a copy of the current HI / HI Fix
# version with only the perk keys changed (same track, same position in Hiraeth's tree). RICE / Royal Court branches kept.
# Mapping: warfare 1-5 -> hth_warfare_legacy_1, _2, _3, warfare_legacy_3, hth_warfare_legacy_5 | glory_legacy_1 -> law_legacy_1
#          erudition 1-3 -> hth_erudition_legacy_1, _2, kin_legacy_2 | law_legacy_1 -> hth_law_legacy_1 | guile_legacy_1 -> hth_guile_legacy_1
#          ep1_culture_legacy_X unchanged (Hiraeth keeps those keys on the same track)

# Historic Invasions Fix and Addon, 09_almohad_effects.txt
almohad_add_dynasty_perks_effect = {
	add_dynasty_perk = hth_warfare_legacy_1
	add_dynasty_perk = hth_erudition_legacy_1
	add_dynasty_perk = hth_erudition_legacy_2
	add_dynasty_perk = kin_legacy_2
}

